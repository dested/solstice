PORT=2567
NODE_ENV=production
# Required when running more than one game process:
# REDIS_URL=redis://localhost:6379
# PUBLIC_ADDRESS=game-1.example.com
# Comma-separated browser origins; defaults to same-host only in production.
# ALLOWED_ORIGINS=https://solstice.example.com
# Client build override, only needed when frontend and matchmaking are separate:
# VITE_SERVER_URL=https://solstice.example.com

# Shared game/bot service secret. Required in production to enable bots.
# BOT_SECRET=replace-with-a-long-random-value
BOT_TARGET=6
# Separate bot service:
# GAME_SERVER_URL=http://localhost:2567
# BOT_WORKER_CAPACITY=24
# PORT=2568
