{
  "name": "solstice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "bun --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "bun server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:network": "bun scripts/network-test.ts",
    "benchmark": "bun scripts/benchmark.ts",
    "bots": "bun bots/index.ts",
    "test:scaling": "bun scripts/scaling-test.ts",
    "test:browser": "bun build scripts/browser-test.ts --target node --external @playwright/test --outfile artifacts/browser-test.mjs && node artifacts/browser-test.mjs",
    "format": "prettier --write src server shared bots scripts tests *.json *.ts *.md deploy/*.md deploy/*.yaml drydock.yaml"
  },
  "dependencies": {
    "@colyseus/bun-websockets": "0.18.2",
    "@colyseus/core": "0.18.10",
    "@colyseus/redis-driver": "0.18.2",
    "@colyseus/redis-presence": "^0.18.0",
    "@colyseus/sdk": "0.18.2",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4.2.0",
    "@types/bun": "^1.3.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.1.0",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0"
  }
}
