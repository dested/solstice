{
  "name": "solstice",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:client": "vite --host 0.0.0.0",
    "dev:server": "bun --watch server/index.ts",
    "build": "tsc --noEmit && vite build",
    "start": "bun server/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:network": "bun scripts/network-test.ts",
    "benchmark": "bun scripts/benchmark.ts",
    "bots": "bun bots/index.ts"
  },
  "dependencies": {
    "@colyseus/bun-websockets": "0.18.2",
    "@colyseus/core": "0.18.10",
    "@colyseus/redis-driver": "0.18.2",
    "@colyseus/redis-presence": "^0.18.0",
    "@colyseus/sdk": "0.18.2",
    "lucide-react": "^0.577.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "tailwindcss": "^4.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "vite": "^7.3.0",
    "typescript": "^5.9.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/three": "^0.183.0",
    "@types/bun": "^1.3.0",
    "@playwright/test": "^1.58.0"
  }
}
